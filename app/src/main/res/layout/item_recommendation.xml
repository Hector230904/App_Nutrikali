<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/recommendationImage"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_food_placeholder"
            android:contentDescription="Alimento"
            android:background="#AEE637"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/recommendationTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ensalada de quinoa"
                android:textColor="#149C68"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/recommendationSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="300 kcal · 12g proteína"
                android:textColor="#383939"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_forward"
            android:contentDescription="Ver más"
            android:tint="#149C68" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>